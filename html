
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sri Abilesh V | JavaScript Developer</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: #f8fafc;
            line-height: 1.6;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: #111827;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            color: #a78bfa;
            font-size: 24px;
            font-weight: bold;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 22px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #a78bfa;
        }

        section {
            padding: 80px 8%;
        }

        .hero {
            min-height: 85vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
        }

        .hero h1 {
            font-size: clamp(32px, 5vw, 55px);
            margin-bottom: 15px;
        }

        .hero h1 span,
        h2 {
            color: #a78bfa;
        }

        .hero p {
            color: #cbd5e1;
            max-width: 600px;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            padding: 12px 24px;
            margin: 5px 8px 5px 0;
            background: #8b5cf6;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            border: 1px solid #8b5cf6;
            transition: 0.3s;
        }

        .btn:hover {
            background: transparent;
            transform: translateY(-3px);
        }

        h2 {
            font-size: 32px;
            margin-bottom: 25px;
        }

        .about p {
            max-width: 800px;
            color: #cbd5e1;
        }

        .skills,
        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .card {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #334155;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-6px);
            border-color: #a78bfa;
        }

        .card h3 {
            color: #c4b5fd;
            margin-bottom: 10px;
        }

        .card p {
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        .contact p {
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        footer {
            text-align: center;
            padding: 25px;
            background: #111827;
            color: #94a3b8;
        }

        #menu-btn {
            display: none;
            font-size: 26px;
            background: none;
            border: none;
            color: white;
            cursor: pointer;
        }

        @media (max-width: 700px) {
            header {
                padding: 18px 5%;
            }

            #menu-btn {
                display: block;
            }

            nav {
                display: none;
                flex-direction: column;
                position: absolute;
                top: 65px;
                left: 0;
                width: 100%;
                padding: 20px;
                background: #111827;
            }

            nav.active {
                display: flex;
            }

            nav a {
                margin: 10px 0;
            }

            section {
                padding: 60px 6%;
            }

            .hero {
                min-height: 75vh;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">Sri Abilesh V.</div>

        <button id="menu-btn" aria-label="Toggle navigation"
                aria-expanded="false">☰</button>

        <nav id="navbar">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <section class="hero" id="home">
        <h1>Hello, I'm <span>Sri Abilesh V</span></h1>
        <h2>JavaScript Developer</h2>
        <p>
            I am a passionate beginner web developer who enjoys creating
            interactive, responsive, and user-friendly websites using
            HTML, CSS, and JavaScript.
        </p>

        <div>
            <a href="#projects" class="btn">View My Projects</a>
            <a href="#contact" class="btn">Contact Me</a>
        </div>
    </section>

    <section class="about" id="about">
        <h2>About Me</h2>
        <p>
            Hello! I'm Sri Abilesh V. I am learning web development and
            improving my programming skills. I enjoy building websites,
            solving problems, and learning new technologies. My goal is
            to become a skilled JavaScript developer and create useful
            web applications.
        </p>
    </section>

    <section id="skills">
        <h2>My Skills</h2>

        <div class="skills">
            <div class="card">
                <h3>HTML5</h3>
                <p>Creating the structure of web pages.</p>
            </div>

            <div class="card">
                <h3>CSS3</h3>
                <p>Designing attractive and responsive websites.</p>
            </div>

            <div class="card">
                <h3>JavaScript</h3>
                <p>Adding interactivity and functionality to websites.</p>
            </div>
        </div>
    </section>

    <section id="projects">
        <h2>My Projects</h2>

        <div class="projects">
            <div class="card">
                <h3>Number Guessing Game</h3>
                <p>
                    A simple game where users guess a random number
                    and receive hints.
                </p>
                <a href="#contact" class="btn">Know More</a>
            </div>

            <div class="card">
                <h3>To-Do List</h3>
                <p>
                    A task management application to add and track
                    daily activities.
                </p>
                <a href="#contact" class="btn">Know More</a>
            </div>

            <div class="card">
                <h3>Weather App</h3>
                <p>
                    A weather application concept for displaying
                    current weather information.
                </p>
                <a href="#contact" class="btn">Know More</a>
            </div>
        </div>
    </section>

    <section class="contact" id="contact">
        <h2>Contact Me</h2>
        <p>Have a project or opportunity? Feel free to connect with me.</p>

        <!-- Replace the example email and links with your real details. -->
        <a href="mailto:yourmail@example.com" class="btn">Email Me</a>
        <a href="https://github.com/" class="btn"
           target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/" class="btn"
           target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </section>

    <footer>
        <p>© <span id="year"></span> Sri Abilesh V. All rights reserved.</p>
    </footer>

    <script>
        const menuBtn = document.getElementById("menu-btn");
        const navbar = document.getElementById("navbar");

        menuBtn.addEventListener("click", () => {
            const isOpen = navbar.classList.toggle("active");
            menuBtn.setAttribute("aria-expanded", isOpen);
            menuBtn.textContent = isOpen ? "✕" : "☰";
        });

        document.querySelectorAll("#navbar a").forEach(link => {
            link.addEventListener("click", () => {
                navbar.classList.remove("active");
                menuBtn.setAttribute("aria-expanded", "false");
                menuBtn.textContent = "☰";
            });
        });

        document.getElementById("year").textContent =
            new Date().getFullYear();
    </script>

</body>
</html>
